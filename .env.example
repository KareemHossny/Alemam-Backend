NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=1

MONGO_URI=mongodb://127.0.0.1:27017/alemam-task-manager
JWT_SECRET=replace_with_a_long_random_secret_value
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Comma-separated list of allowed frontend origins.
# Required in production. In development, localhost defaults are available.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Local development can use "lax". Production is forced to "none" by the server config.
AUTH_COOKIE_SAME_SITE=lax

LOG_LEVEL=debug
LOG_SERVICE_NAME=alemam-task-manager-api

# Platform-managed variables such as VERCEL are usually injected automatically.
